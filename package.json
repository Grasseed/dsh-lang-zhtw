{
  "name": "dsh-lang-zhtw",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "繁體中文（台灣）語言包：以 OpenCC 轉換 DSH 內建簡體介面字典，未覆蓋字串自動退回簡體。Traditional Chinese (Taiwan) language pack for DeepSeek Harness.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "language-pack",
    "zh-TW",
    "traditional-chinese"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grasseed/dsh-lang-zhtw.git"
  },
  "author": "Grasseed",
  "devDependencies": {
    "opencc-js": "^1.3.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
